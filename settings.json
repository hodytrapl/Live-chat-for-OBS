{
    // Настройки пользователя
    "user_settings": {
        // Название Twitch-канала, за которым будет следить бот.
        // Значение по умолчанию: "" (пустая строка) или не задано — бот не подключается.
        "channel": "YOUR_CHANNEL_NAME",

        // Тема оформления (визуальная тема для бота/виджетов).
        // Формат: "название_темы/версия". По умолчанию: "minecraft/1"
        "Theme": "minecraft/1"
    },

    // Настройка событий, на которые бот должен реагировать
    "events": {
        // Отслеживать присоединение пользователя к чату (вход).
        // По умолчанию: false (если поле отсутствует)
        "TwitchJoinUser": true,

        // Отслеживать выход пользователя из чата (покидание).
        // По умолчанию: false
        "TwitchLeaveUser": true,

        // Отслеживать первое сообщение пользователя в чате (за текущую сессию).
        // По умолчанию: false
        "TwitchFirstMessageUser": true
    }
    // ===== ДОСТУПНЫЕ ТЕМЫ (для настройки поля "Theme") =====
    // Укажите тему в формате: "название_темы/номер_версии"
    // Пример: "minecraft/1" — тема Minecraft, версия "Серверная"
    //
    // Список тем (system_error исключена):
    // - "default/0"     (Классическая тема по умолчанию)
    // - "minecraft/0"   (Minecraft Классическая)
    // - "minecraft/1"   (Minecraft Серверная)
    // - "minecraft/2"   (Minecraft Сезоны лололошки)
    // - "terraria/0"    (Terraria Основная)
    // - "inscryption/0" (Inscryption акт 1 Леший)
}
